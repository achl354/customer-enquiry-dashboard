# Copy to .env and fill in for live mailbox polling / AI classification.
# Leave blank to run in seed/demo mode with the rule-based classifier only.

PORT=4000

# Azure AD app registration (see README.md "Live ingestion setup")
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# The shared mailbox to poll, e.g. sales@jdhealthcare.com.au
MAILBOX=

# Anthropic API key for AI-based triage classification (see README.md "AI classification").
# Leave blank to use the rule-based classifier only.
ANTHROPIC_API_KEY=
