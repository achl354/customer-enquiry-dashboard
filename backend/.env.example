# Copy to .env and fill in for live mailbox polling.
# Leave blank to run in seed/demo mode only (no live ingestion).

PORT=4000

# Azure AD app registration (see README.md "Live ingestion setup")
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# The shared mailbox to poll, e.g. sales@jdhealthcare.com.au
MAILBOX=
