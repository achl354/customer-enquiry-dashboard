# Copy to .env for local dev, where the frontend (Vite, port 5173) and
# backend (Express, port 4000) run as two separate servers.
#
# Leave this unset in production/single-origin deployments (e.g. Render) —
# the app defaults to a same-origin relative /api path when this isn't set.
VITE_API_BASE=http://localhost:4000/api
